# ── 复制为 .env 后填写（.env 不会被提交）──────────────────
# Tavily：会议/新闻补充层检索（https://tavily.com）
TAVILY_API_KEY=

# DeepSeek 兼容接口：用于 AI 解读、跨主题总结、会议关键试验抽取
# 任何 OpenAI 兼容端点均可（本地 vLLM / Ollama 网关 / 官方 API）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# ── 以下为可选 ──────────────────────────────────────────
# MedEvidence 工具层目录（PubTator 3 / OpenTargets 采集）；不设置时自动找同级目录
# MEDEX_PATH=/path/to/medevidence/medevidence_deploy/project

# 看板"留白配图"生成（webapp /api/figure；不配则自动跳过）
# COMETAPI_KEY=
# COMETAPI_ENDPOINT=https://api.cometapi.com
